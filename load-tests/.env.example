# =====================================================================
# KISSARIYA — k6 LOAD TEST ENVIRONMENT (EXAMPLE — NO REAL SECRETS)
# =====================================================================
# This file is a TEMPLATE. Never commit a real .env file.
#
# The load test uses ONLY the public "anon" / publishable key that the
# browser application itself uses (src/integrations/supabase/client.ts).
# NEVER use the service_role key, the database password, or any admin
# credential here.
#
# The anon key is NOT a secret: it is embedded in the public web bundle.
# Still, it is good practice to keep it in environment variables.
#
# To run a test:
#   copy this file to load-tests/.env (not committed), fill the values,
#   then run from PowerShell:
#     $env:SUPABASE_URL = "..."
#     $env:SUPABASE_ANON_KEY = "..."
#     k6 run -e MAX_VUS=100 load-tests/supabase-read-load.js
#   or pass everything inline with -e flags (values stay out of scripts).
# =====================================================================

# URL of the REAL Supabase project (Dashboard -> Settings -> API).
# The application's committed example already sets:
#   VITE_SUPABASE_URL="https://ygkeuhatokvkdwwoccty.supabase.co"
# Use the same value here.
SUPABASE_URL=https://ygkeuhatokvkdwwoccty.supabase.co

# Public "anon" key of that project (publishable, browser-safe).
# The application's committed example already sets:
#   VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGci...anon..."
# Placeholder here — paste the real anon key locally, never commit it.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY_HERE

# ---- Load level (progressive staging) ----
# 100 -> 500 -> 1000 -> 2000 -> 5000
MAX_VUS=100

# ---- Stage durations ----
RAMP_UP=90s
SUSTAIN_DURATION=2m
RAMP_DOWN=60s
